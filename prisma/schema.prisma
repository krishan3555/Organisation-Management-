generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  email     String?  @unique
  password  String?  // Hashed password for MVP
  role      String   @default("USER") // SUPER_ADMIN, ADMIN, MEMBER
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  member    Member?
}

model Member {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId        String   @unique // e.g., NPVS-2026-0001
  fullName        String
  guardianName    String?
  dateOfBirth     DateTime?
  gender          String?
  village         String?
  address         String?
  photo           String?
  education       String?
  skills          String?
  occupation      String?
  designation     String   @default("Member")
  joiningDate     DateTime @default(now())
  membershipType  String   @default("Member") // Member, Volunteer, Employee
  status          String   @default("APPROVED")
  qrToken         String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MembershipApplication {
  id               String   @id @default(cuid())
  fullName         String
  guardianName     String?
  dateOfBirth      DateTime?
  gender           String?
  mobile           String
  email            String?
  village          String?
  address          String?
  education        String?
  skills           String?
  occupation       String?
  requestedRole    String   @default("Member")
  reason           String?
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
}

model Event {
  id                   String   @id @default(cuid())
  title                String
  description          String
  category             String?
  image                String?
  venue                String?
  date                 DateTime?
  startTime            String?
  endTime              String?
  registrationDeadline DateTime?
  capacity             Int?
  rules                String?
  eligibility          String?
  status               String   @default("DRAFT")
  createdAt            DateTime @default(now())
}
